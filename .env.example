# Copy to .env and fill in. .env is gitignored and holds local secrets.

# LoRa channel pre-shared keys (base64). Must be identical on every node and
# the gateway. Generate/inspect with the Meshtastic CLI or app; format: base64:...
# Telemetry channel (CPS_RTC, index 0) — required by every script.
LORA_TELEMETRY_CHANNEL_PSK=base64:CHANGE_ME
# Messaging channel (PUC_NET, index 1) — required by the PBX-attached nodes.
LORA_MSG_CHANNEL_PSK=base64:CHANGE_ME

# Serial port of the USB-connected LILYGO gateway. Read by docker-compose.yaml
# for BOTH the device passthrough and the gateway-receiver container env.
# Must live here in .env (Compose interpolation file) — NOT in configuration.env,
# which is env_file-only and invisible to ${...} passthrough interpolation.
GATEWAY_SERIAL_PORT=/dev/ttyACM0