# Copy to configuration.env and set real values. configuration.env is gitignored.
# Consumed by the influxdb and telegraf containers (see docker-compose.yaml).

# InfluxDB options (consumed by the influxdb + telegraf containers)
INFLUXDB_DB=cpsrtc_meshtastic_telemetry
INFLUXDB_ADMIN_USER=admin
INFLUXDB_ADMIN_PASSWORD=change_me

# Web monitor DB credentials (same InfluxDB account, different var names)
DB_USERNAME=admin
DB_PASSWORD=change_me

# ── MQTT broker credentials ──────────────────────────────────────────────────
# The broker no longer accepts anonymous clients (mqtt/mosquitto.conf). One
# account per publisher so a compromised or misconfigured collector cannot write
# outside its own namespace — the per-topic rules live in mqtt/aclfile.
#
# Generate these together with the broker's password file:
#     ./mqtt/init-credentials.sh
# which writes mqtt/pwfile (gitignored) and prints the block to paste here.
MQTT_USERNAME_GATEWAY=gateway
MQTT_PASSWORD_GATEWAY=change_me

MQTT_USERNAME_TELEGRAF=telegraf
MQTT_PASSWORD_TELEGRAF=change_me

MQTT_USERNAME_MONITOR=monitor
MQTT_PASSWORD_MONITOR=change_me

# PBX-site collectors (ADR-0002). Each may only write its own subtree.
MQTT_PASSWORD_P1=change_me
MQTT_PASSWORD_P2=change_me
