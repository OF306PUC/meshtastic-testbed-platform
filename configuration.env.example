# Copy to configuration.env and set real values. configuration.env is gitignored.
# Consumed by the influxdb and telegraf containers (see docker-compose.yaml).

# InfluxDB options (consumed by the influxdb + telegraf containers)
INFLUXDB_DB=cpsrtc_lora_telemetry
INFLUXDB_ADMIN_USER=admin
INFLUXDB_ADMIN_PASSWORD=change_me

# Web monitor DB credentials (same InfluxDB account, different var names)
DB_USERNAME=admin
DB_PASSWORD=change_me
